#!/bin/bash
#SBATCH --job-name=eiffel_150_seasplat
#SBATCH --output=logs/eiffel_150/seasplat_%j.out
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:a30:2
#SBATCH --time=72:00:00
#SBATCH --partition=acltr

set -euo pipefail

module purge
module load Anaconda3
module load CUDA/12.1.1

set +u
eval "$(conda shell.bash hook)"
conda activate seasplat
set -u

cd /home/arua/projects/3dgs/seasplat
mkdir -p logs/eiffel_150

# Sanity check
python - <<'PY'
import torch
print(f"CUDA available: {torch.cuda.is_available()}")
PY

SOURCE_PATH="/home/arua/projects/3dgs/datasets/prepared/Eiffel_Tower_150"
DATASET_NAME="eiffel_150_seasplat"

echo "--- Starting SeaSplat Training on Eiffel Tower 150 ---"
python train.py \
    -s "$SOURCE_PATH" \
    --exp "${DATASET_NAME}" \
    --do_seathru \
    --iterations 15000 \
    --seathru_from_iter 5000 \
    --port 0 \
    --eval